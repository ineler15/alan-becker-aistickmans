# Copia este archivo a ".env" y completa tus valores.

# Proveedor de IA activo: anthropic | openrouter | groq | ollama | openai | gemini
AI_PROVIDER=gemini

# Solo necesitas rellenar la key del proveedor que uses en AI_PROVIDER.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Keys individuales por personaje (opcional) - si existe, se usa en vez de la de arriba,
# asi cada uno tiene su propio cupo gratuito en vez de compartir el de GEMINI_API_KEY.
GEMINI_API_KEY_ORANGE=
GEMINI_API_KEY_RED=
GEMINI_API_KEY_PURPLE=
GEMINI_API_KEY_GREEN=
GEMINI_API_KEY_BLUE=
GEMINI_API_KEY_YELLOW=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# Ollama corre local, no necesita API key
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b

# Cada cuantos segundos "piensa" el stickman en el loop autonomo
TICK_INTERVAL_SECONDS=12

# Hotkey global para pausar/reanudar el loop
PAUSE_HOTKEY=Control+Alt+P

# Carpeta donde la IA puede leer/escribir archivos sin pedir confirmacion
WORKSPACE_DIR=./workspace

# Color inicial del stickman (tambien se puede cambiar desde el menu del tray)
STICKMAN_COLOR=#111111
